# 1. Supabase Config (Client & Serveur)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre_cle_publique_ici"
SUPABASE_SERVICE_ROLE_KEY="votre_cle_secrete_serveur_ici"

# 2. Replicate API Config (Strictement Serveur)
REPLICATE_API_TOKEN="r8_votre_token_replicate_ici"

# 3. Security & Rate Limiting (Optionnel pour Dev local, Recommandé Prod)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 4. App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
